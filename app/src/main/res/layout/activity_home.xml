<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <Button
        android:id="@+id/btnLogout"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="24dp"
        android:text="Logout"
        android:textColor="#E8C6C6"
        android:textSize="12sp"
        android:fontFamily="@font/font4"
        app:strokeColor="#E8C6C6"
        app:strokeWidth="1dp"
        app:backgroundTint="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="20dp"
        android:padding="8dp"
        android:text="Hello User"
        android:textSize="32sp"
        android:letterSpacing="0.08"
        android:fontFamily="@font/font4"
        android:textColor="#E8C6C6"
        android:shadowColor="#FF66B2"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="2"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnLogout" />

    <ImageView
        android:id="@+id/ivPriceList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:scaleType="fitCenter"
        android:src="@drawable/price_list"
        android:contentDescription="Τιμοκατάλογος Υπηρεσιών"
        app:layout_constraintBottom_toTopOf="@+id/btnMyAppointments"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvGreeting" />

    <Button
        android:id="@+id/btnMyAppointments"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="16dp"
        android:text="My Appointments"
        android:fontFamily="@font/font4"
        android:textSize="16sp"
        android:textColor="#E8C6C6"
        app:strokeColor="#E8C6C6"
        app:strokeWidth="1.5dp"
        app:backgroundTint="#000000"
        app:layout_constraintBottom_toTopOf="@+id/tvBookAppointment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/tvBookAppointment"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="48dp"
        android:text="Book your appointment!"
        android:fontFamily="@font/font4"
        android:textSize="16sp"
        android:textColor="#E8C6C6"
        android:letterSpacing="0.05"
        app:strokeColor="#E8C6C6"
        app:strokeWidth="1.5dp"
        app:backgroundTint="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>