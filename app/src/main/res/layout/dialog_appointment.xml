<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#151515"
    android:padding="24dp"> <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Ραντεβού"
    android:textColor="#FF66B2"
    android:textSize="28sp"
    android:fontFamily="@font/font4"
    android:textStyle="italic"
    android:gravity="center"
    android:shadowColor="#000000"
    android:shadowDx="2"
    android:shadowDy="2"
    android:shadowRadius="2"
    android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Υπηρεσία:"
        android:textColor="#E8C6C6"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinnerService"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#FF66B2"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Ημερομηνία:"
        android:textColor="#E8C6C6"
        android:textSize="18sp"
        android:textStyle="bold|italic" />

    <CalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@android:style/ThemeOverlay.Material.Dark"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvSelectTimeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Διαθέσιμες Ώρες:"
        android:textColor="#E8C6C6"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinnerHours"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#FF66B2"
        android:visibility="gone"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnConfirmAppointment"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Επιβεβαίωση"
        android:textColor="#FF66B2"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:fontFamily="@font/font4"
        app:strokeColor="#FF66B2"
        app:strokeWidth="1.5dp"
        app:backgroundTint="#000000" />

</LinearLayout>