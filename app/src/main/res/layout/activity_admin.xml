<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="20dp"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Panel"
            android:textColor="#FF66B2"
            android:textSize="24sp"
            android:fontFamily="@font/font4"
            android:layout_centerVertical="true"/>

        <Button
            android:id="@+id/btnAdminLogout"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:layout_alignParentEnd="true"
            android:text="Logout"
            android:textColor="#E8C6C6"
            android:textSize="11sp"
            app:strokeColor="#E8C6C6"
            app:strokeWidth="1dp"
            app:backgroundTint="#000000" />
    </RelativeLayout>

    <CalendarView
        android:id="@+id/adminCalendarView"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:theme="@android:style/ThemeOverlay.Material.Dark"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/tvDateStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="Επιλέξτε ημερομηνία..."
        android:textColor="#E8C6C6"
        android:textSize="16sp"
        android:fontFamily="@font/font4"
        android:background="#111111"
        android:layout_marginTop="5dp" />

    <Button
        android:id="@+id/btnBlockTime"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:text="Δέσμευση Ολόκληρης Ημέρας"
        android:textColor="#FF4C4C"
        android:textSize="16sp"
        android:fontFamily="@font/font4"
        android:enabled="false"
        app:strokeColor="#FF4C4C"
        app:strokeWidth="1.5dp"
        app:backgroundTint="#000000" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Λεπτομέρειες Ημέρας:"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"
        android:textAllCaps="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/appointmentsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>