<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- ΠΑΝΩ ΔΕΞΙΑ: Login & Sign Up -->
        <LinearLayout
            android:id="@+id/authMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/loginText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" | "
                android:textColor="@color/nude_pink"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/signupText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Up"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- ΚΕΝΤΡΟ: Logo (Στρογγυλό) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/logoCard"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_below="@id/authMenu"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="60dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/logoImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/kalypsws_nails_logo" />
        </androidx.cardview.widget.CardView>

        <!-- ΚΕΙΜΕΝΟ: Η δουλειά μου -->
        <TextView
            android:id="@+id/myWorkTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/logoCard"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:text="Η δουλειά μου"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- GRID ΜΕ ΤΙΣ 9 ΦΩΤΟΓΡΑΦΙΕΣ (Σε 2 στήλες) -->
        <GridLayout
            android:id="@+id/photoGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/myWorkTitle"
            android:layout_marginTop="16dp"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:layout_marginBottom="32dp">

            <!-- Φωτογραφία 1 -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/nail_1" />

            <!-- Φωτογραφία 2 -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/nail_2" />

            <!-- Φωτογραφία 3 -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/nail_3" />

            <!-- Φωτογραφία 4 -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/nail_4" />

            <!-- Φωτογραφία 5 -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/nail_5" />

            <!-- Φωτογραφία 6 -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/nail_6" />

            <!-- Φωτογραφία 7 -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/nail_7" />

            <!-- Φωτογραφία 8 -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/nail_8" />

            <!-- Φωτογραφία 9 -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/nail_9" />

        </GridLayout>

        <!-- ΚΑΤΩ ΔΕΞΙΑ: Instagram -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/photoGrid"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instagram"
                android:textColor="@color/nude_pink"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <!-- Αν έβαλες το λογότυπο του insta, βάλε εδώ το όνομά του (π.χ. @drawable/instagram_logo) -->
            <ImageView
                android:id="@+id/instaIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_camera" />
        </LinearLayout>

    </RelativeLayout>
</ScrollView>