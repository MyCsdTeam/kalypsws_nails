<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    android:gravity="center"
    android:padding="32dp">

    <!-- 1. IMAGEVIEW ΣΕ ΚΥΚΛΟ (Μεγαλύτερο Μέγεθος: 220dp) -->
    <androidx.cardview.widget.CardView
        android:layout_width="340dp"
        android:layout_height="350dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="110dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/logoImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/kalypsws_nails_logo" />
    </androidx.cardview.widget.CardView>


    <!-- 2. EDITTEXT: Πεδίο για το Όνομα -->
    <EditText
        android:id="@+id/nameEditText"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Το όνομά σας"
        android:textColorHint="@color/hint_color"
        android:textColor="@color/white"
        android:backgroundTint="@color/nude_pink"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp"/>

    <!-- EDITTEXT: Πεδίο για το Τηλέφωνο -->
    <EditText
        android:id="@+id/phoneEditText"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Το κινητό σας τηλέφωνο"
        android:textColorHint="@color/hint_color"
        android:textColor="@color/white"
        android:backgroundTint="@color/nude_pink"
        android:inputType="phone"
        android:layout_marginBottom="40dp"/>

    <!-- ΟΡΙΖΟΝΤΙΟ ΚΟΥΤΙ ΓΙΑ ΤΑ ΔΥΟ ΚΟΥΜΠΙΑ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- 3. BUTTON: Κουμπί ΣΥΝΔΕΣΗ -->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="ΣΥΝΔΕΣΗ"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/nude_pink" />

        <!-- BUTTON: Κουμπί ΕΓΓΡΑΦΗ -->
        <Button
            android:id="@+id/registerButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="ΕΓΓΡΑΦΗ"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/nude_pink" />

    </LinearLayout>

</LinearLayout>