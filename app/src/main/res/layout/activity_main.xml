<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- Κουμπιά πάνω δεξιά (Ροζ) -->
    <Button
        android:id="@+id/btnSignUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:text="Sign Up"
        android:textColor="#FFFFFF"
        app:backgroundTint="#FF66B2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="Login"
        android:textColor="#FFFFFF"
        app:backgroundTint="#FF66B2"
        app:layout_constraintEnd_toStartOf="@+id/btnSignUp"
        app:layout_constraintTop_toTopOf="@+id/btnSignUp"
        app:layout_constraintBottom_toBottomOf="@+id/btnSignUp"/>

    <!-- Το ScrollView για να κατεβαίνει η οθόνη με τις φωτογραφίες -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/btnSignUp"
        app:layout_constraintBottom_toTopOf="@+id/footerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Το Logo (Μεγαλύτερο) με το ροζ περίγραμμα -->
            <FrameLayout
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginTop="20dp">

                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/kalypsws_nails_logo" />
            </FrameLayout>

            <!-- Κείμενο με καλλιγραφική γραμματοσειρά (cursive) -->
            <TextView
                android:id="@+id/tvMyWork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="Η δουλειά μου"
                android:textSize="32sp"
                android:fontFamily="cursive"
                android:textColor="#FFFFFF" />

            <!-- Αρχή ανομοιόμορφης διάταξης φωτογραφιών -->
            <!-- 1η φωτογραφία: Μεγάλη -->
            <ImageView
                android:id="@+id/ivNail10"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp"
                android:src="@drawable/nail_10" />

            <!-- 2η και 3η φωτογραφία: Σε μία σειρά, μισές μισές -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/ivNail2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/nail_2" />

                <ImageView
                    android:id="@+id/ivNail3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scaleType="centerCrop"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/nail_3" />
            </LinearLayout>

            <!-- 4η φωτογραφία: Μακρόστενη στη μέση -->
            <ImageView
                android:id="@+id/ivNail4"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp"
                android:src="@drawable/nail_4" />

            <!-- Υπόλοιπες φωτογραφίες όπως τις όρισες -->
            <ImageView
                android:id="@+id/ivNail5"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp"
                android:src="@drawable/nail_5" />

            <ImageView
                android:id="@+id/ivNail6"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp"
                android:src="@drawable/nail_6" />

            <ImageView
                android:id="@+id/ivNail7"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp"
                android:src="@drawable/nail_7" />

            <ImageView
                android:id="@+id/ivNail8"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp"
                android:src="@drawable/nail_8" />

            <ImageView
                android:id="@+id/ivNail9"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp"
                android:src="@drawable/nail_9" />

            <ImageView
                android:id="@+id/ivNail1"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp"
                android:src="@drawable/nail_1" />

        </LinearLayout>
    </ScrollView>

    <!-- Footer: Instagram Logo & Link (Μαύρο φόντο, ροζ γράμματα) -->
    <LinearLayout
        android:id="@+id/footerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivInstagram"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/instagram_logo" />

        <TextView
            android:id="@+id/tvInstaLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="\@kalypsws_nails"
            android:textColor="#FF66B2"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
